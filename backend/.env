# Đường dẫn file SQLite (dùng /tmp/kidlearn.db khi deploy lên Vercel)
KIDLEARN_DATABASE_PATH=./kidlearn.db

# Thời gian session (giây) — mặc định 7 ngày
KIDLEARN_SESSION_TTL_SECONDS=604800

# Các origin được phép gọi API (phân cách bằng dấu phẩy)
KIDLEARN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
